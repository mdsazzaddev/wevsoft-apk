/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), interest-cohort=()

# Content-hashed bundles never change: cache for a year, skip revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Entry documents + service worker must always revalidate so deploys go live immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/push-sw.js
  Cache-Control: no-cache
/boot-theme.js
  Cache-Control: public, max-age=0, must-revalidate
# Versioned (?v=) boot shell + launch icons: repeat launches paint the splash from cache.
/boot-shell.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/robots.txt
  Cache-Control: public, max-age=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logo.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Static art: serve from cache, refresh in the background.
/calligraphy/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/reactions/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/widgets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/phantom/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/studio-ml/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
